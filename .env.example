# Copy to .env and export these (the app reads the process environment; it does not load .env itself).

# --- Access control -------------------------------------------------------
# Operator key for /api/keys/*, /analytics/* and /api/marketing/stats (sent as X-Admin-Key).
# If unset, those routes are disabled. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

# Comma-separated list of allowed browser origins. "*" allows any origin (credentials are then disabled).
ALLOWED_ORIGINS=*

# Public key signups per client IP per hour. Set TRUST_PROXY=true only behind a proxy you control,
# so the first X-Forwarded-For address is used as the client IP.
FREE_KEY_LIMIT_PER_HOUR=5
TRUST_PROXY=

# --- Stripe (optional; billing routes return 503 until configured) -----------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=
API_BASE_URL=http://localhost:8000

# --- Key storage ---------------------------------------------------------------------
# json (default) or sqlite. sqlite keeps key and usage counts process-safe and imports existing JSON keys once.
KEY_STORE=json
KEY_DB_PATH=api_keys.sqlite3

# --- State files (JSON). Point these at a persistent volume in production. ---------
API_KEYS_FILE=api_keys.json
RATE_LIMIT_FILE=rate_limits.json
SUBSCRIPTIONS_FILE=subscriptions.json
MARKETING_ANALYTICS_FILE=marketing_analytics.json
